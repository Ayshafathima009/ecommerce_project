# ==========================================
# MERAI SIEME — Environment Configuration
# Target Domain: merai.sieme.in
# ==========================================

# Flask Environment
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change_this_to_a_secure_random_key_for_merai_sieme_2026

# PostgreSQL Database Connection
# If not configured, the backend automatically reports development mode.
DATABASE_URL=postgresql://merai_user:your_secure_password@localhost:5432/merai_db

# JWT Configuration
JWT_SECRET_KEY=change_this_jwt_secret_key_32chars_minimum_here
JWT_EXPIRATION_HOURS=72

# Target Domain and CORS
ALLOWED_ORIGINS=https://merai.sieme.in,http://localhost:3000,http://localhost:5173

# Optional SMTP Email Notifications for Distributors
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@sieme.in
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@merai.sieme.in
